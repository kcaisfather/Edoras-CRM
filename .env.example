# EdorasCRM — .env.local olarak kopyalayıp doldurun. İKİ Supabase projesi kullanılır.

# --- CRM projesi (orishbqniebbgdanazrp): CRM personel girişi + crm_* tabloları -------------------
# Adres ve anon/publishable anahtar tarayıcıya gider; yalnız giriş/çıkış için kullanılır.
NEXT_PUBLIC_SUPABASE_URL=https://orishbqniebbgdanazrp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — YALNIZ sunucu (Dashboard → Project Settings → API Keys). Asla commit'lenmez.
SUPABASE_SERVICE_ROLE_KEY=

# --- Edoras canlı veritabanı (bmjkpxbrmwxuildwakly — edoras-admin ve mobil) ----------------------
# Yalnız sunucu: kurum listesi, kullanım sayıları, demo açarken kurum + yönetici oluşturma.
# Değerler edoras-admin'in .env.local'ındaki NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY.
EDORAS_SUPABASE_URL=
EDORAS_SUPABASE_SERVICE_ROLE_KEY=

# Kurum yöneticilerinin girdiği Edoras paneli (demo giriş bilgisinde gösterilir). Boşsa bu adres.
NEXT_PUBLIC_EDORAS_PANEL_URL=https://panel.edorasapp.ai

# --- Anketler ------------------------------------------------------------------------------------
# Panelin herkese açık adresi: anket linkleri {NEXT_PUBLIC_APP_URL}/s/{token} olarak kurulur (e-posta, WhatsApp, SMS).
# Boşsa sunucuda isteğin adresi, tarayıcıda açık sayfanın adresi kullanılır; ÜRETİMDE TANIMLAYIN (örn. vekil sunucu
# arkasında e-postadaki link iç adresi göstermesin). Değiştirince yeniden derleyin (NEXT_PUBLIC_ derlemeye gömülür).
NEXT_PUBLIC_APP_URL=
# Anket e-postası (Resend REST API; İSTEĞE BAĞLI). İKİSİ de doluysa "E-posta" kanalı açılır; biri boşsa kanal
# kapalıdır, uç 503 MAIL_NOT_CONFIGURED döner ve WhatsApp / SMS / Link sağlayıcısız çalışır.
# RESEND_API_KEY yalnız sunucu, asla commit'lenmez. EMAIL_FROM Resend'de doğrulanmış alan adından olmalı,
# örn. "Edoras <anket@edorasapp.ai>" (onboarding@resend.dev yalnız hesap sahibine gönderir; kullanmayın).
RESEND_API_KEY=
EMAIL_FROM=

# --- Faturalar (İSTEĞE BAĞLI) --------------------------------------------------------------------
# Fatura talebi e-postasının gideceği muhasebeci adresi. RESEND_API_KEY + EMAIL_FROM ile BİRLİKTE doluysa "Fatura kes >
# E-posta ile talep" açılır; biri boşsa yöntem kapalıdır (uç 503 MAIL_NOT_CONFIGURED, ekran "Elle kayıt"ı önerir).
ACCOUNTANT_EMAIL=
# Paraşüt API v4 (beşi de doluysa "Fatura kes > Platforma aktar" açılır; fatura Paraşüt'te kesilip e-Fatura / e-Arşiv
# olarak resmileştirilir). Kimlik: Paraşüt'ten API erişimi (client id/secret) istenir; USERNAME/PASSWORD Paraşüt'e giren
# kullanıcının e-postası ve şifresi; COMPANY_ID panel adresindeki sayı (uygulama.parasut.com/<COMPANY_ID>/...).
# Yalnız sunucu, asla commit'lenmez.
PARASUT_CLIENT_ID=
PARASUT_CLIENT_SECRET=
PARASUT_USERNAME=
PARASUT_PASSWORD=
PARASUT_COMPANY_ID=
# İsteğe bağlı: fatura kalemindeki hizmetin Paraşüt kimliği. Boşsa "EDORAS-LISANS" kodlu hizmet aranır, yoksa açılır.
PARASUT_PRODUCT_ID=

# --- Raporlar (zamanlanmış rapor e-postaları; Ayarlar → Raporlar) --------------------------------
# Dağıtıcı POST /api/cron/reports (Vercel Cron için GET de) bu anahtarla korunur: "Authorization: Bearer <CRON_SECRET>".
# TANIMSIZSA uç 503 verir (secret yoksa herkese açık olmaz). Üretin: openssl rand -hex 32. Yalnız sunucu, asla commit'lenmez.
# Vercel'de aynı adla proje ortam değişkeni olarak tanımlanınca Vercel Cron Bearer başlığını kendisi ekler.
# Hobby planında Vercel cron günde en çok bir kez çalışır; sık tetikleme için harici zamanlayıcı ya da Supabase pg_cron
# + pg_net kullanın (README → Raporlar → Zamanlayıcı kurulumu). E-posta için RESEND_API_KEY + EMAIL_FROM da gerekir (yukarıda).
CRON_SECRET=
